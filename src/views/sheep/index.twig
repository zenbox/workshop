{# src/views/sheep/index.twig
   Erwartet: sheep = Liste aus HerdController.list (Felder: id, name, breed, age, gender, genderLabel)
   Änderungen laufen über die REST-API unter /herd:
   POST /herd, GET /herd/:id, PUT /herd/:id, DELETE /herd/:id
  Socket-Ereignisse halten die globale Tabelle und Aktivität live aktuell. #}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Schafe</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css">

    <!-- >>>>>>> -->
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
<!-- <<<<<<< -->

  <style>
    body { font-family: Barlow, sans-serif; color: #000; background: #fff; }
    table { border-collapse: collapse; }
    th, td { border: 1px solid #000; padding: 0.25rem 0.5rem; text-align: left; }
    dialog { color: #000; background: #fff; border: 1px solid #000; }
    .live-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
    .live-list { display: grid; gap: 0.4rem; max-height: 15rem; overflow: auto; padding: 0; list-style: none; }
    .bubble { max-width: 85%; padding: 0.4rem 0.7rem; border-radius: 1rem; background: #edf1f3; overflow-wrap: anywhere; }
    .chat-bubble.mine { margin-left: auto; background: #d9f1e4; }
    .chat-bubble.theirs { margin-right: auto; background: #edf1f3; }
    #chat-form { display: flex; gap: 0.4rem; }
    #chat-text { flex: 1; min-width: 0; }
  </style>


</head>
<body>
  <h1>Schafe</h1>

  <main>
    <button type="button" id="new">
      <i class="ph ph-plus" aria-hidden="true"></i> Neues Schaf
    </button>

<!-- >>>>>>> -->
<label for="user">Benutzer</label>
<select id="user">
  <option value="1" {{ currentUser == 1 ? 'selected' }}>Demo</option>
  <option value="2" {{ currentUser == 2 ? 'selected' }}>Jonas</option>
</select>
<!-- <<<<<<< -->

    <p id="error" role="alert" hidden></p>

    <table>
      <caption>Herde</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Rasse</th>
          <th scope="col">Alter</th>
          <th scope="col">Geschlecht</th>
          <th scope="col">Besitzer</th>
          <th scope="col"><span hidden>Aktionen</span></th>
        </tr>
      </thead>
      <tbody id="rows">
        {% for s in sheep %}
        <tr data-id="{{ s.id }}">
          <td>{{ s.name }}</td>
          <td>{{ s.breed }}</td>
          <td>{{ s.age }}</td>
          <td>{{ s.genderLabel }}</td>
          <td>{{ s.ownerName }}</td>
          <td>
            {% if s.userId == currentUser %}
            <button type="button" data-action="edit" title="{{ s.name }} bearbeiten" aria-label="{{ s.name }} bearbeiten">
              <i class="ph ph-pencil-simple" aria-hidden="true"></i>
            </button>
            <button type="button" data-action="delete" title="{{ s.name }} löschen" aria-label="{{ s.name }} löschen">
              <i class="ph ph-trash" aria-hidden="true"></i>
            </button>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="live-panels">
      <section aria-labelledby="activity-title">
        <h2 id="activity-title">Live-Aktivität</h2>
        <p id="connection-status" role="status">Verbinde …</p>
        <p id="online-users">Niemand online</p>
        <ol id="activity-list" class="live-list" aria-live="polite"></ol>
      </section>

      <section aria-labelledby="chat-title">
        <h2 id="chat-title">Chat</h2>
        <ol id="chat-list" class="live-list" aria-live="polite"></ol>
        <form id="chat-form">
          <label for="chat-text" hidden>Nachricht</label>
          <input id="chat-text" name="message" type="text" maxlength="500" autocomplete="off" required>
          <button type="submit" aria-label="Nachricht senden" title="Nachricht senden">
            <i class="ph ph-paper-plane-right" aria-hidden="true"></i>
          </button>
        </form>
      </section>
    </div>
  </main>

  <dialog id="dlg" aria-labelledby="dlg-title">
    <form id="form">
      <h2 id="dlg-title">Neues Schaf</h2>

      <p>
        <label for="name">Name</label><br>
        <input id="name" name="name" type="text" required maxlength="50" pattern=".*\S.*">
      </p>
      <p>
        <label for="breed">Rasse</label><br>
        <input id="breed" name="breed" type="text" required maxlength="50" pattern=".*\S.*">
      </p>
      <p>
        <label for="age">Alter</label><br>
        <input id="age" name="age" type="number" required min="0" max="25" step="1">
      </p>
      <p>
        <label for="gender">Geschlecht</label><br>
        <select id="gender" name="gender" required>
          <option value="female">weiblich</option>
          <option value="male">männlich</option>
        </select>
      </p>

      <p>
        <button type="submit">
          <i class="ph ph-floppy-disk" aria-hidden="true"></i> Speichern
        </button>
        <button type="button" id="cancel">
          <i class="ph ph-x" aria-hidden="true"></i> Abbrechen
        </button>
      </p>
    </form>
  </dialog>

  <script>
    // >>>>>>>
    const API = '/herd';

    // >>>>>>>
const USER = {{ currentUser }};


document.getElementById('user').addEventListener('change', (e) => {
  location.search = `?user=${e.target.value}`;
});


const socket = io({ auth: { userId: USER } });

const activityList = document.getElementById('activity-list');
const chatList = document.getElementById('chat-list');
const chatForm = document.getElementById('chat-form');
const chatText = document.getElementById('chat-text');
const onlineUsers = document.getElementById('online-users');
const connectionStatus = document.getElementById('connection-status');
let activeUsers = [];

function appendBubble(list, text, className) {
  const item = document.createElement('li');
  item.className = className;
  item.textContent = text;
  list.append(item);
  while (list.children.length > 100) list.firstElementChild.remove();
  list.scrollTop = list.scrollHeight;
}

function activityText(activity) {
  if (activity.type === 'presence') {
    return activity.action === 'joined'
      ? `${activity.userName} ist online.`
      : `${activity.userName} ist offline.`;
  }
  const actions = { created: 'hat ein Schaf angelegt', updated: 'hat ein Schaf verändert', deleted: 'hat ein Schaf gelöscht' };
  return `${activity.userName} ${actions[activity.action] ?? 'hat ein Schaf geändert'}: ${activity.sheepName}`;
}

function showActivity(activity) {
  appendBubble(activityList, activityText(activity), 'bubble');
}

function showChatMessage(message) {
  const side = message.userId === USER ? 'mine' : 'theirs';
  appendBubble(chatList, `${message.userName}: ${message.text}`, `bubble chat-bubble ${side}`);
}

function showOnlineUsers(users) {
  onlineUsers.textContent = users.length
    ? `Online: ${users.map((user) => user.userName).join(', ')}`
    : 'Niemand online';
}

function makeSheepRow(sheep) {
  const row = document.createElement('tr');
  row.dataset.id = sheep.id;
  [sheep.name, sheep.breed, sheep.age, sheep.genderLabel, sheep.ownerName].forEach((value) => {
    const cell = document.createElement('td');
    cell.textContent = value;
    row.append(cell);
  });

  const actions = document.createElement('td');
  if (sheep.userId === USER) {
    for (const [action, icon, label] of [
      ['edit', 'pencil-simple', 'bearbeiten'],
      ['delete', 'trash', 'löschen'],
    ]) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.action = action;
      button.title = `${sheep.name} ${label}`;
      button.setAttribute('aria-label', button.title);
      const glyph = document.createElement('i');
      glyph.className = `ph ph-${icon}`;
      glyph.setAttribute('aria-hidden', 'true');
      button.append(glyph);
      actions.append(button);
    }
  }
  row.append(actions);
  return row;
}

function applySheepChange(activity) {
  const row = [...document.getElementById('rows').children]
    .find((item) => item.dataset.id === String(activity.sheep.id));
  if (activity.action === 'deleted') {
    row?.remove();
  } else {
    const updatedRow = makeSheepRow(activity.sheep);
    if (row) row.replaceWith(updatedRow);
    else document.getElementById('rows').append(updatedRow);
  }
}

socket.on('connect', () => { connectionStatus.textContent = 'Verbunden'; });
socket.on('disconnect', () => { connectionStatus.textContent = 'Verbindung getrennt'; });
socket.on('activity:history', (items) => {
  activityList.replaceChildren();
  items.forEach(showActivity);
});
socket.on('activity:message', (activity) => {
  showActivity(activity);
  if (activity.type === 'presence') {
    activeUsers = activity.action === 'joined'
      ? [...activeUsers.filter((user) => user.userId !== activity.userId), { userId: activity.userId, userName: activity.userName }]
      : activeUsers.filter((user) => user.userId !== activity.userId);
    showOnlineUsers(activeUsers);
  }
  if (activity.type === 'sheep') applySheepChange(activity);
});
socket.on('presence:state', (users) => {
  activeUsers = users;
  showOnlineUsers(activeUsers);
});
socket.on('chat:history', (messages) => {
  chatList.replaceChildren();
  messages.forEach(showChatMessage);
});
socket.on('chat:message', showChatMessage);

chatForm.addEventListener('submit', (event) => {
  event.preventDefault();
  const text = chatText.value.trim();
  if (!text || !socket.connected) return;
  socket.emit('chat:send', text);
  chatText.value = '';
});
// <<<<<<<

    const form = document.getElementById('form');
    const dlg = document.getElementById('dlg');
    const title = document.getElementById('dlg-title');
    const errorEl = document.getElementById('error');

    let editingId = null;

    function showError(message) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function clearError() {
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    // REST-Aufruf. Bei Erfolg { data: ... } oder 204 ohne Inhalt.
    async function api(method, url, body) {
      const res = await fetch(url, {
        method,
    // >>>>>>>
headers: {
  'X-User-Id': String(USER),
  ...(body ? { 'Content-Type': 'application/json' } : {}),
},
// <<<<<<<
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 204) return null;
      const json = await res.json().catch(() => null);
      if (!res.ok) throw new Error(json?.error ?? `Fehler ${res.status}`);
      return json?.data ?? null;
    }

    function openDialog(s = null) {
      clearError();
      editingId = s ? s.id : null;
      form.reset();
      title.textContent = s ? 'Schaf bearbeiten' : 'Neues Schaf';
      if (s) {
        form.elements.name.value = s.name;
        form.elements.breed.value = s.breed;
        form.elements.age.value = s.age;
        form.elements.gender.value = s.gender;
      }
      dlg.showModal();
      form.elements.name.focus();
    }

    async function edit(id) {
      try {
        clearError();
        openDialog(await api('GET', `${API}/${id}`));
      } catch (err) {
        showError(err.message);
      }
    }

    async function remove(id, name) {
      if (!confirm(`${name} löschen?`)) return;
      try {
        clearError();
        await api('DELETE', `${API}/${id}`);
      } catch (err) {
        showError(err.message);
      }
    }

    // Ein Listener für alle Zeilen
    document.getElementById('rows').addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      const tr = e.target.closest('tr');
      if (!btn || !tr) return;
      const id = Number(tr.dataset.id);
      if (btn.dataset.action === 'edit') edit(id);
      if (btn.dataset.action === 'delete') remove(id, tr.cells[0].textContent);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const body = {
        name: form.elements.name.value.trim(),
        breed: form.elements.breed.value.trim(),
        age: Number(form.elements.age.value),
        gender: form.elements.gender.value,
      };
      try {
        clearError();
        if (editingId === null) {
          await api('POST', API, body);
        } else {
          await api('PUT', `${API}/${editingId}`, body);
        }
        dlg.close();
      } catch (err) {
        showError(err.message);
      }
    });

    document.getElementById('new').addEventListener('click', () => openDialog());
    document.getElementById('cancel').addEventListener('click', () => dlg.close());
    // <<<<<<<
  </script>
</body>
</html>
